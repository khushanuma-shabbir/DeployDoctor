# DeployDoctor Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED FOR PRODUCTION
# ===========================================

# Node environment (development | production)
NODE_ENV=production

# Server port (Render sets this automatically)
PORT=10000

# API Authentication (REQUIRED in production)
# Generate a strong random string: openssl rand -base64 32
API_KEY=your-secret-api-key-here

# Frontend origin for CORS (comma-separated for multiple)
# Example: https://your-app.vercel.app,https://your-preview.vercel.app
FRONTEND_ORIGIN=https://your-frontend-domain.vercel.app

# ===========================================
# DATABASE AND STORAGE
# ===========================================

# Path to SQLite database (use /var/data for Render persistent disk)
DATABASE_PATH=/var/data/deploydoctor.db

# Directory for reports and screenshots (use /var/data for Render persistent disk)
REPORTS_DIR=/var/data/reports

# ===========================================
# QA AGENT CONFIGURATION
# ===========================================

# Maximum concurrent QA sessions (1 recommended for Render basic tier)
MAX_CONCURRENT_QA_SESSIONS=1

# QA session timeout in milliseconds (default: 30 minutes)
QA_SESSION_TIMEOUT_MS=1800000

# ===========================================
# FRONTEND CONFIGURATION (for Vercel)
# ===========================================

# Backend API URL (set in Vercel environment variables)
VITE_API_BASE_URL=https://your-backend.onrender.com

# API Key for frontend (same as backend API_KEY)
# Only needed if frontend makes authenticated requests
VITE_API_KEY=your-secret-api-key-here

# ===========================================
# OPTIONAL CONFIGURATION
# ===========================================

# Enable debug logging
DEBUG=false

# Custom Playwright executable path (usually not needed)
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
